# Keep real server settings in .env.local and in your hosting environment.
FIREBASE_ADMIN_SERVICE_ACCOUNT=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Enable requests from non-browser applications in EmailJS Account > Security.
# If private-key authorization is enabled, set this only on the server:
EMAILJS_PRIVATE_KEY=
# Template recipient and code placeholders, without the surrounding braces:
EMAILJS_EMAIL_VARIABLE=to_email
EMAILJS_CODE_VARIABLE=verification_code
# The template also receives to_name and expires_in.
