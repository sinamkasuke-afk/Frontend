rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    match /users/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.createdAt == request.time
        && (request.resource.data.role == 'student' || (admin() && request.resource.data.role == 'admin'));
      allow update: if admin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt'])
        && request.resource.data.role in ['student', 'admin'];
      allow delete: if false;
    }
    match /venues/{id} {
      allow read: if resource.data.active == true || admin();
      allow write: if admin();
    }
    match /timeSlots/{id} {
      allow read: if signedIn();
      // Keep slot intervals fixed and non-overlapping. Change via the trusted seed tool.
      allow write: if false;
    }
    match /reservations/{id} {
      allow read: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      // Callable functions validate data and atomically maintain bookings and audit events.
      allow write: if false;
    }
    match /bookings/{id} {
      // Occupancy contains no account details; authenticated users need it for availability.
      allow read: if signedIn();
      allow write: if false;
    }
    match /reservationEvents/{id} {
      allow read: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }
  }
}
