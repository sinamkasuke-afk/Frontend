rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function dateValue(value) {
      let parts = value.split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
    }
    function today() { return (request.time + duration.value(8, 'h')).date(); }
    function approvedStudent() {
      return signedIn()
        && request.auth.token.email.matches('^[^@]+@gmail[.]com$')
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('enrollmentStatus', 'pending') == 'approved'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('confirmedStudentId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId;
    }
    function limited(id) { return getAfter(/databases/$(database)/documents/submissionLimits/$(id)).data; }
    match /submissionLimits/{id} {
      allow get: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['count','ownerUid','reservationId','updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 5
        && request.resource.data.count == (exists(/databases/$(database)/documents/submissionLimits/$(id)) ? resource.data.count + 1 : 1)
        && request.resource.data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId))
        && reservation(request.resource.data.reservationId).quotaId == id
        && reservation(request.resource.data.reservationId).ownerUid == request.auth.uid;
      allow delete: if false;
    }
    match /counters/reservations {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['value','reservationId'])
        && request.resource.data.value is int
        && request.resource.data.value >= 1 && request.resource.data.value <= 99999
        && request.resource.data.value == (exists(/databases/$(database)/documents/counters/reservations) ? resource.data.value + 1 : 1)
        && !exists(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId))
        && reservation(request.resource.data.reservationId).ownerUid == request.auth.uid
        && reservation(request.resource.data.reservationId).requestNumber == request.resource.data.value
        && reservation(request.resource.data.reservationId).createdAt == request.time;
      allow delete: if false;
    }
    match /adminApplications/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','email','displayName','status','createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 100
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      // Activation requires trusted Firebase Admin SDK credentials, never browser writes.
      allow update, delete: if false;
    }
    match /users/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'studentId', 'enrollmentStatus', 'approvedBy', 'updatedAt', 'confirmedStudentId', 'studentIdConfirmedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.studentId is string && request.resource.data.studentId.size() <= 50
        && request.resource.data.enrollmentStatus == (admin() ? 'approved' : 'pending')
        && !request.resource.data.keys().hasAny(['approvedBy','updatedAt','confirmedStudentId','studentIdConfirmedAt'])
        && (request.resource.data.role == 'student' || (admin() && request.resource.data.role == 'admin'));
      allow update: if admin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'studentId', 'enrollmentStatus', 'approvedBy', 'updatedAt', 'confirmedStudentId', 'studentIdConfirmedAt'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.enrollmentStatus in ['approved','rejected']
        && request.resource.data.studentId is string && request.resource.data.studentId.size() >= 1 && request.resource.data.studentId.size() <= 50
        && request.resource.data.updatedAt == request.time && request.resource.data.approvedBy == request.auth.uid;
      allow update: if signedIn() && request.auth.uid == uid
        && resource.data.role == 'student'
        && resource.data.enrollmentStatus == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmedStudentId', 'studentIdConfirmedAt'])
        && request.resource.data.confirmedStudentId == resource.data.studentId
        && request.resource.data.studentIdConfirmedAt == request.time;
      allow delete: if false;
    }
    match /venues/{id} {
      allow read: if resource.data.active == true || admin();
      allow write: if admin();
    }
    match /timeSlots/{id} {
      allow read: if signedIn();
      // Keep slot intervals fixed and non-overlapping. Change via the trusted seed tool.
      allow write: if false;
    }
    function reservation(id) { return getAfter(/databases/$(database)/documents/reservations/$(id)).data; }
    function lock(id) { return getAfter(/databases/$(database)/documents/bookings/$(id)).data; }
    function audit(id) { return getAfter(/databases/$(database)/documents/reservationEvents/$(id)).data; }
    match /reservations/{id} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/reservations/$(id)) || admin() || resource.data.ownerUid == request.auth.uid);
      allow list: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if !exists(/databases/$(database)/documents/bookingDays/$(request.resource.data.venueId + '_' + request.resource.data.dateISO))
        && (admin() || approvedStudent())
        && request.resource.data.keys().hasOnly(['id','requestId','requestNumber','ownerUid','requester','requesterType','initials','venueId','venue','venueDetail','slotId','dateISO','date','time','event','expectedGuests','organization','eventType','purpose','contactPerson','facilityRequirements','setupNotes','status','bookingId','createdAt','quotaId','lastEventId'])
        && request.resource.data.id == id && request.resource.data.requestId == id
        && request.resource.data.requestNumber is int
        && request.resource.data.requestNumber >= 1 && request.resource.data.requestNumber <= 99999
        && getAfter(/databases/$(database)/documents/counters/reservations).data.value == request.resource.data.requestNumber
        && getAfter(/databases/$(database)/documents/counters/reservations).data.reservationId == id
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.dateISO.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && dateValue(request.resource.data.dateISO) >= today()
        && dateValue(request.resource.data.dateISO) <= today() + duration.value(90, 'd')
        && dateValue(request.resource.data.dateISO).year() == int(request.resource.data.dateISO.split('-')[0])
        && dateValue(request.resource.data.dateISO).month() == int(request.resource.data.dateISO.split('-')[1])
        && dateValue(request.resource.data.dateISO).day() == int(request.resource.data.dateISO.split('-')[2])
        && request.resource.data.date == request.resource.data.dateISO
        && request.resource.data.requester == (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName.size() > 0 ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName : request.auth.token.email)
        && request.resource.data.requesterType == (admin() ? 'Admin' : 'Student')
        && request.resource.data.venue == get(/databases/$(database)/documents/venues/$(request.resource.data.venueId)).data.name
        && request.resource.data.venueDetail == get(/databases/$(database)/documents/venues/$(request.resource.data.venueId)).data.get('location', '')
        && request.resource.data.time == get(/databases/$(database)/documents/timeSlots/$(request.resource.data.slotId)).data.label
        && request.resource.data.quotaId.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && dateValue(request.resource.data.quotaId.split('_')[1]) == today()
        && limited(request.resource.data.quotaId).reservationId == id
        && limited(request.resource.data.quotaId).count <= 5
        && request.resource.data.event is string && request.resource.data.event.size() > 0 && request.resource.data.event.size() <= 4000
        && request.resource.data.organization is string && request.resource.data.organization.size() <= 4000
        && request.resource.data.eventType is string && request.resource.data.eventType.size() <= 4000
        && request.resource.data.purpose is string && request.resource.data.purpose.size() <= 4000
        && request.resource.data.contactPerson is string && request.resource.data.contactPerson.size() <= 4000
        && request.resource.data.facilityRequirements is string && request.resource.data.facilityRequirements.size() <= 4000
        && request.resource.data.setupNotes is string && request.resource.data.setupNotes.size() <= 4000
        && request.resource.data.expectedGuests is int && request.resource.data.expectedGuests > 0
        && get(/databases/$(database)/documents/venues/$(request.resource.data.venueId)).data.active == true
        && request.resource.data.expectedGuests <= get(/databases/$(database)/documents/venues/$(request.resource.data.venueId)).data.get('capacity', 100000)
        && get(/databases/$(database)/documents/timeSlots/$(request.resource.data.slotId)).data.active == true
        && request.resource.data.slotId in ['morning','midday','afternoon']
        && get(/databases/$(database)/documents/timeSlots/$(request.resource.data.slotId)).data.startMinutes == {'morning':420,'midday':600,'afternoon':780}[request.resource.data.slotId]
        && get(/databases/$(database)/documents/timeSlots/$(request.resource.data.slotId)).data.endMinutes == {'morning':600,'midday':780,'afternoon':960}[request.resource.data.slotId]
        && request.resource.data.bookingId == request.resource.data.venueId + '_' + request.resource.data.dateISO + '_' + request.resource.data.slotId
        && lock(request.resource.data.bookingId).reservationId == id
        && audit(request.resource.data.lastEventId).reservationId == id
        && audit(request.resource.data.lastEventId).action == 'submitted';
      allow update: if admin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','reviewedBy','lastEventId'])
        && request.resource.data.status in ['approved','declined','expired']
        && (request.resource.data.status != 'approved' || request.time < resource.data.createdAt + duration.value(48, 'h'))
        && (request.resource.data.status != 'expired' || request.time >= resource.data.createdAt + duration.value(48, 'h'))
        && request.resource.data.updatedAt == request.time && request.resource.data.reviewedBy == request.auth.uid
        && audit(request.resource.data.lastEventId).reservationId == id
        && audit(request.resource.data.lastEventId).action == request.resource.data.status
        && ((request.resource.data.status == 'approved' && lock(resource.data.bookingId).reservationId == id)
          || (request.resource.data.status in ['declined','expired'] && (!existsAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)) || lock(resource.data.bookingId).reservationId != id)));
      allow update: if (admin() || (signedIn() && resource.data.ownerUid == request.auth.uid))
        && resource.data.status in ['pending','approved']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','cancelledBy','lastEventId'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.updatedAt == request.time && request.resource.data.cancelledBy == request.auth.uid
        && (admin() || dateValue(resource.data.dateISO) + duration.value(('startMinutes' in resource.data ? resource.data.startMinutes : get(/databases/$(database)/documents/timeSlots/$(resource.data.slotId)).data.startMinutes), 'm') > request.time + duration.value(8, 'h'))
        && audit(request.resource.data.lastEventId).reservationId == id
        && audit(request.resource.data.lastEventId).action == 'cancelled'
        && (!existsAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId))
          || lock(resource.data.bookingId).reservationId != id);
      allow delete: if false;
      match /documents/{documentId} {
        allow read, write: if false;
      }
    }
    match /bookings/{id} {
      allow read: if signedIn();
      function matchesReservation() {
        let data = request.resource.data;
        let parent = reservation(data.reservationId);
        return data.keys().hasOnly(['reservationId','venueId','dateISO','slotId','status','createdAt','startMinutes','endMinutes'])
          && parent.bookingId == id && parent.venueId == data.venueId
          && parent.slotId == data.slotId && parent.dateISO == data.dateISO
          && (!('startMinutes' in parent) || (data.startMinutes == parent.startMinutes && data.endMinutes == parent.endMinutes))
          && data.status == parent.status && parent.status in ['pending','approved']
          && data.createdAt == request.time
          && ((parent.ownerUid == request.auth.uid && parent.createdAt == request.time) || admin());
      }
      allow create: if signedIn() && matchesReservation() && !('startMinutes' in reservation(request.resource.data.reservationId));
      allow update: if signedIn() && matchesReservation()
        && ((admin() && request.resource.data.reservationId == resource.data.reservationId)
          || (resource.data.get('status', '') == 'pending'
            && request.time >= resource.data.createdAt + duration.value(48, 'h')
            && get(/databases/$(database)/documents/reservations/$(resource.data.reservationId)).data.status == 'pending'
            && request.resource.data.reservationId != resource.data.reservationId
            && reservation(request.resource.data.reservationId).createdAt == request.time));
      allow delete: if (admin() && reservation(resource.data.reservationId).status in ['declined','cancelled','expired'])
        || (signedIn() && reservation(resource.data.reservationId).ownerUid == request.auth.uid
          && reservation(resource.data.reservationId).status == 'cancelled'
          && reservation(resource.data.reservationId).cancelledBy == request.auth.uid
          && reservation(resource.data.reservationId).updatedAt == request.time);
    }
    match /reservationEvents/{id} {
      allow read: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reservationId','ownerUid','actorUid','action','status','createdAt'])
        && request.resource.data.createdAt == request.time && request.resource.data.actorUid == request.auth.uid
        && reservation(request.resource.data.reservationId).ownerUid == request.resource.data.ownerUid
        && reservation(request.resource.data.reservationId).lastEventId == id
        && ((request.resource.data.action == 'submitted' && reservation(request.resource.data.reservationId).createdAt == request.time
          && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == 'pending')
          || (admin() && request.resource.data.action in ['approved','declined','expired']
          && reservation(request.resource.data.reservationId).updatedAt == request.time
          && request.resource.data.status == reservation(request.resource.data.reservationId).status)
          || (request.resource.data.action == 'cancelled' && request.resource.data.status == 'cancelled'
          && reservation(request.resource.data.reservationId).cancelledBy == request.auth.uid
          && reservation(request.resource.data.reservationId).updatedAt == request.time
          && (admin() || request.resource.data.ownerUid == request.auth.uid)));
      allow update, delete: if false;
    }
  }
}
