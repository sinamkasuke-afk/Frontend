rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    match /users/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.createdAt == request.time
        && (request.resource.data.role == 'student' || (admin() && request.resource.data.role == 'admin'));
      allow update: if admin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt'])
        && request.resource.data.role in ['student', 'admin'];
      allow delete: if false;
    }
    match /venues/{id} {
      allow read: if resource.data.active == true || admin();
      allow write: if admin();
    }
    match /timeSlots/{id} {
      allow read: if signedIn();
      // Keep slot intervals fixed and non-overlapping. Change via the trusted seed tool.
      allow write: if false;
    }
    function reservation(id) { return getAfter(/databases/$(database)/documents/reservations/$(id)).data; }
    function lock(id) { return getAfter(/databases/$(database)/documents/bookings/$(id)).data; }
    function audit(id) { return getAfter(/databases/$(database)/documents/reservationEvents/$(id)).data; }
    match /reservations/{id} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/reservations/$(id)) || admin() || resource.data.ownerUid == request.auth.uid);
      allow list: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['id','requestId','ownerUid','requester','requesterType','initials','venueId','venue','venueDetail','slotId','dateISO','date','time','event','expectedGuests','organization','eventType','purpose','contactPerson','facilityRequirements','setupNotes','status','bookingId','createdAt','attachment','lastEventId'])
        && request.resource.data.id == id && request.resource.data.requestId == id
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.dateISO.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.event is string && request.resource.data.event.size() > 0
        && request.resource.data.expectedGuests is int && request.resource.data.expectedGuests > 0
        && get(/databases/$(database)/documents/venues/$(request.resource.data.venueId)).data.active == true
        && request.resource.data.expectedGuests <= get(/databases/$(database)/documents/venues/$(request.resource.data.venueId)).data.get('capacity', 100000)
        && get(/databases/$(database)/documents/timeSlots/$(request.resource.data.slotId)).data.active == true
        && request.resource.data.bookingId == request.resource.data.venueId + '_' + request.resource.data.dateISO + '_' + request.resource.data.slotId
        && lock(request.resource.data.bookingId).reservationId == id
        && audit(request.resource.data.lastEventId).reservationId == id
        && audit(request.resource.data.lastEventId).action == 'submitted';
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','reviewedBy','lastEventId'])
        && request.resource.data.status in ['approved','declined']
        && request.resource.data.updatedAt == request.time && request.resource.data.reviewedBy == request.auth.uid
        && audit(request.resource.data.lastEventId).reservationId == id
        && audit(request.resource.data.lastEventId).action == request.resource.data.status
        && ((request.resource.data.status == 'approved' && lock(resource.data.bookingId).reservationId == id)
          || (request.resource.data.status == 'declined' && !existsAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId))));
      allow delete: if (admin() || (signedIn() && resource.data.ownerUid == request.auth.uid))
        && (!('bookingId' in resource.data)
          || !existsAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId))
          || lock(resource.data.bookingId).reservationId != id);
      match /documents/{documentId} {
        allow read: if admin() || (signedIn() && get(/databases/$(database)/documents/reservations/$(id)).data.ownerUid == request.auth.uid);
        allow create: if signedIn() && documentId == 'proposal'
          && reservation(id).ownerUid == request.auth.uid && reservation(id).createdAt == request.time
          && request.resource.data.keys().hasOnly(['base64','name','size','contentType'])
          && request.resource.data.contentType == 'application/pdf'
          && request.resource.data.size <= 512000 && request.resource.data.size > 0
          && request.resource.data.base64 is string && request.resource.data.base64.size() <= 683000;
        allow update: if false;
        allow delete: if admin() || (signedIn()
          && get(/databases/$(database)/documents/reservations/$(id)).data.ownerUid == request.auth.uid
          && !existsAfter(/databases/$(database)/documents/reservations/$(id)));
      }
    }
    match /bookings/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reservationId','venueId','dateISO','slotId','createdAt'])
        && reservation(request.resource.data.reservationId).bookingId == id
        && reservation(request.resource.data.reservationId).venueId == request.resource.data.venueId
        && reservation(request.resource.data.reservationId).slotId == request.resource.data.slotId
        && reservation(request.resource.data.reservationId).dateISO == request.resource.data.dateISO
        && request.resource.data.createdAt == request.time
        && ((reservation(request.resource.data.reservationId).ownerUid == request.auth.uid && reservation(request.resource.data.reservationId).createdAt == request.time)
          || admin())
        && reservation(request.resource.data.reservationId).status in ['pending','approved'];
      allow update: if admin() && request.resource.data.reservationId == resource.data.reservationId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow delete: if (admin() && (!existsAfter(/databases/$(database)/documents/reservations/$(resource.data.reservationId))
        || reservation(resource.data.reservationId).status == 'declined'))
        || (signedIn()
          && get(/databases/$(database)/documents/reservations/$(resource.data.reservationId)).data.ownerUid == request.auth.uid
          && !existsAfter(/databases/$(database)/documents/reservations/$(resource.data.reservationId)));
    }
    match /reservationEvents/{id} {
      allow read: if admin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reservationId','ownerUid','actorUid','action','status','createdAt'])
        && request.resource.data.createdAt == request.time && request.resource.data.actorUid == request.auth.uid
        && reservation(request.resource.data.reservationId).ownerUid == request.resource.data.ownerUid
        && reservation(request.resource.data.reservationId).lastEventId == id
        && ((request.resource.data.action == 'submitted' && reservation(request.resource.data.reservationId).createdAt == request.time
          && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == 'pending')
          || (admin() && request.resource.data.action in ['approved','declined']
          && reservation(request.resource.data.reservationId).updatedAt == request.time
          && request.resource.data.status == reservation(request.resource.data.reservationId).status));
      allow update, delete: if false;
    }
  }
}
